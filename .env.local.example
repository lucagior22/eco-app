# URL pública de la app (usada por el manifest de la PWA y los metadatos).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave de la API de Gemini para la detección de perillas de /pedal.
# Se obtiene gratis en https://aistudio.google.com/apikey
# Solo se usa del lado del servidor: NUNCA prefijarla con NEXT_PUBLIC_.
# Sin esta variable, /pedal responde con un mensaje narrado y el resto de la app
# funciona normalmente.
GEMINI_API_KEY=

# Modelo multimodal a usar. Opcional: si no se define, se usa
# gemini-3.5-flash-lite (3,7 s por foto contra 27-44 s de los flash grandes, sin
# peor acierto en el angulo segun medicion propia).
# Queda como variable porque los modelos del tier gratuito rotan y se deprecian:
# gemini-2.5-flash ya dejo de estar disponible y devolvia 404.
GEMINI_MODEL=gemini-3.5-flash-lite
